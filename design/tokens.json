{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pyxillum Design Tokens Source of Truth",
  "description": "Standardized spatial, typography, metric, and semantic design tokens across Windows, macOS, and Linux native front ends.",
  "spacing": {
    "space_0": 0,
    "space_1": 4,
    "space_2": 8,
    "space_3": 12,
    "space_4": 16,
    "space_5": 20,
    "space_6": 24,
    "space_8": 32,
    "space_10": 40,
    "space_12": 48,
    "space_16": 64
  },
  "radii": {
    "none": 0,
    "chip": 6,
    "control": 8,
    "card": 12,
    "dialog": 12,
    "pill": 999
  },
  "typography": {
    "caption": {
      "size_px": 12,
      "line_height_px": 16,
      "weight": 400
    },
    "body": {
      "size_px": 14,
      "line_height_px": 20,
      "weight": 400
    },
    "body_strong": {
      "size_px": 14,
      "line_height_px": 20,
      "weight": 600
    },
    "subtitle": {
      "size_px": 16,
      "line_height_px": 22,
      "weight": 600
    },
    "title": {
      "size_px": 20,
      "line_height_px": 26,
      "weight": 600
    },
    "display": {
      "size_px": 28,
      "line_height_px": 36,
      "weight": 700
    },
    "dial_readout": {
      "size_px": 40,
      "line_height_px": 48,
      "weight": 700
    }
  },
  "motion": {
    "duration_fast_ms": 150,
    "duration_normal_ms": 250,
    "duration_slow_ms": 400,
    "easing_standard": "cubic-bezier(0.2, 0.0, 0.0, 1.0)",
    "easing_entrance": "cubic-bezier(0.0, 0.0, 0.2, 1.0)",
    "easing_exit": "cubic-bezier(0.4, 0.0, 1.0, 1.0)"
  },
  "semantic_colors": {
    "note": "System colours (surface, text, primary accent) are dynamically supplied by the host OS theme. Tokens define brand and status semantics.",
    "success": {
      "oklch": "oklch(0.72 0.17 142)",
      "hex_fallback": "#22C55E",
      "description": "Indicates active Bluetooth connection, successful write, or valid verification step."
    },
    "warning": {
      "oklch": "oklch(0.79 0.16 75)",
      "hex_fallback": "#EAB308",
      "description": "Non-destructive warning, disconnected preview mode, or degraded BLE signal."
    },
    "danger": {
      "oklch": "oklch(0.63 0.22 29)",
      "hex_fallback": "#EF4444",
      "description": "Safety gate requirement, communication failure, or destructive preset deletion."
    },
    "info": {
      "oklch": "oklch(0.70 0.15 235)",
      "hex_fallback": "#3B82F6",
      "description": "Diagnostic telemetry, Bluetooth guidance banner, or instructional prompt."
    },
    "led_glow": {
      "oklch": "oklch(0.85 0.18 200)",
      "hex_fallback": "#06B6D4",
      "description": "Accent glow for active virtual strip diode illumination."
    }
  },
  "layout_breakpoints": {
    "compact_max_px": 1099,
    "regular_min_px": 1100,
    "wide_min_px": 1500,
    "sidebar_compact_width_px": 56,
    "sidebar_regular_width_px": 240,
    "stage_max_width_px": 1280
  }
}
