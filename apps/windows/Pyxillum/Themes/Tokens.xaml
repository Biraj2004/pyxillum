<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Spatial Spacing Tokens -->
    <x:Double x:Key="Space0">0</x:Double>
    <Thickness x:Key="Space0Thickness">0,0,0,0</Thickness>
    <x:Double x:Key="Space1">4</x:Double>
    <Thickness x:Key="Space1Thickness">4,4,4,4</Thickness>
    <x:Double x:Key="Space2">8</x:Double>
    <Thickness x:Key="Space2Thickness">8,8,8,8</Thickness>
    <x:Double x:Key="Space3">12</x:Double>
    <Thickness x:Key="Space3Thickness">12,12,12,12</Thickness>
    <x:Double x:Key="Space4">16</x:Double>
    <Thickness x:Key="Space4Thickness">16,16,16,16</Thickness>
    <x:Double x:Key="Space5">20</x:Double>
    <Thickness x:Key="Space5Thickness">20,20,20,20</Thickness>
    <x:Double x:Key="Space6">24</x:Double>
    <Thickness x:Key="Space6Thickness">24,24,24,24</Thickness>
    <x:Double x:Key="Space8">32</x:Double>
    <Thickness x:Key="Space8Thickness">32,32,32,32</Thickness>
    <x:Double x:Key="Space10">40</x:Double>
    <Thickness x:Key="Space10Thickness">40,40,40,40</Thickness>
    <x:Double x:Key="Space12">48</x:Double>
    <Thickness x:Key="Space12Thickness">48,48,48,48</Thickness>
    <x:Double x:Key="Space16">64</x:Double>
    <Thickness x:Key="Space16Thickness">64,64,64,64</Thickness>
    <!-- Corner Radii Tokens -->
    <CornerRadius x:Key="RadiusNone">0</CornerRadius>
    <CornerRadius x:Key="RadiusChip">6</CornerRadius>
    <CornerRadius x:Key="RadiusControl">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <!-- Semantic Colors -->
    <Color x:Key="ColorSuccess">#FF22C55E</Color>
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <Color x:Key="ColorWarning">#FFEAB308</Color>
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <Color x:Key="ColorDanger">#FFEF4444</Color>
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <Color x:Key="ColorInfo">#FF3B82F6</Color>
    <SolidColorBrush x:Key="BrushInfo" Color="{StaticResource ColorInfo}" />
    <Color x:Key="ColorLedGlow">#FF06B6D4</Color>
    <SolidColorBrush x:Key="BrushLedGlow" Color="{StaticResource ColorLedGlow}" />

    <!-- Global Hover Invariant Styles: Guarantee ZERO scale transforms or geometry enlargement on hover -->
    <Style TargetType="NavigationViewItem">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <CompositeTransform ScaleX="1.0" ScaleY="1.0" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Button">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <CompositeTransform ScaleX="1.0" ScaleY="1.0" />
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
