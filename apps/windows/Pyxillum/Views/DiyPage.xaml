<Page
    x:Class="Pyxillum.Views.DiyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- Header Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="DIY Custom Sequencer" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="DIY Custom Sequencer" />
                    <TextBlock Text="Design custom multi-node gradient and chase animation sequences" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Design custom multi-node gradient and chase animation sequences" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PlayPauseButton" Content="Play Preview" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Toggle sequence playback" />
                    <Button x:Name="SavePresetButton" Content="Save Preset" AutomationProperties.Name="Save sequence preset" />
                </StackPanel>
            </Grid>

            <!-- Error State InfoBar -->
            <InfoBar x:Name="DiyErrorBar" IsOpen="False" Severity="Error" Title="Sequencer Error" Message="Failed to synchronise DIY keyframe sequence with controller.">
                <InfoBar.ActionButton>
                    <Button x:Name="DiyRetryButton" Content="Retry" AutomationProperties.Name="Retry synchronising sequence" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Loading State Card -->
            <Border x:Name="DiyLoadingCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="24" Height="24" />
                    <TextBlock Text="Transferring sequence keyframes to controller EEPROM..." VerticalAlignment="Center" FontWeight="Medium" />
                </StackPanel>
            </Border>

            <!-- Empty State Card -->
            <Border x:Name="DiyEmptyCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="32" Visibility="Collapsed">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE81C;" FontSize="40" HorizontalAlignment="Center" Opacity="0.4" />
                    <TextBlock Text="No Keyframe Steps Configured" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Add your first animation step node to construct a custom chase or gradient sequence." Opacity="0.7" TextAlignment="Center" />
                    <Button x:Name="EmptyAddStepButton" Content="Add first node" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Add first sequence node" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- 14-Step Timeline Container -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Timeline Keyframe Sequence (Up to 14 Steps)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TimelineNodesPanel" Orientation="Horizontal" Spacing="8" Margin="0,8" />
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Node Editor & Transition Dynamics -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Active Step Colour -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Selected Step Colour" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Grid HorizontalAlignment="Center" Margin="0,8">
                            <Ellipse x:Name="DiyColorPreview" Width="64" Height="64" Fill="#FF3B30" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="2" />
                        </Grid>
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DiySwatchRed" Content="Red" AutomationProperties.Name="Red keyframe colour" />
                                <Button x:Name="DiySwatchGreen" Content="Green" AutomationProperties.Name="Green keyframe colour" />
                                <Button x:Name="DiySwatchBlue" Content="Blue" AutomationProperties.Name="Blue keyframe colour" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DiySwatchAmber" Content="Amber" AutomationProperties.Name="Amber keyframe colour" />
                                <Button x:Name="DiySwatchCyan" Content="Cyan" AutomationProperties.Name="Cyan keyframe colour" />
                                <Button x:Name="DiySwatchMagenta" Content="Magenta" AutomationProperties.Name="Magenta keyframe colour" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="AddStepButton" Content="Add Node" AutomationProperties.Name="Add sequence node" />
                            <Button x:Name="RemoveStepButton" Content="Remove Node" AutomationProperties.Name="Remove sequence node" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Column: Sequence Dynamics -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="12,0,0,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Sequence Dynamics" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="Animation Speed" FontSize="12" Opacity="0.7" />
                            <Slider x:Name="DiySpeedSlider" Minimum="1" Maximum="32" Value="16" AutomationProperties.Name="Sequence playback speed" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Direction" FontSize="12" Opacity="0.7" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="ForwardButton" Content="Forward -&gt;" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.Name="Set forward animation direction" />
                                <Button x:Name="ReverseButton" Content="&lt;- Reverse" AutomationProperties.Name="Set reverse animation direction" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
