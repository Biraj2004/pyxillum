<Page
    x:Class="Pyxillum.Views.SolidPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- Header Section -->
            <StackPanel Spacing="4">
                <TextBlock Text="Solid Colour" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Solid Colour" />
                <TextBlock Text="Static hues, colour temperature calibration, and curated swatches" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Static hues, colour temperature calibration, and curated swatches" />
            </StackPanel>

            <!-- Error State InfoBar -->
            <InfoBar x:Name="SolidErrorBar" IsOpen="False" Severity="Error" Title="Colour Update Error" Message="Failed to transmit RGB colour parameters to controller.">
                <InfoBar.ActionButton>
                    <Button x:Name="SolidRetryButton" Content="Retry" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Loading State Card -->
            <Border x:Name="SolidLoadingCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="24" Height="24" />
                    <TextBlock Text="Transferring static colour to controller..." VerticalAlignment="Center" FontWeight="Medium" />
                </StackPanel>
            </Border>

            <!-- Empty State Card -->
            <Border x:Name="SolidEmptyCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="32" Visibility="Collapsed">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE790;" FontSize="40" HorizontalAlignment="Center" Opacity="0.4" />
                    <TextBlock Text="No Colour Active" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a colour swatch or adjust the RGB sliders to calibrate controller diodes." Opacity="0.7" TextAlignment="Center" />
                    <Button x:Name="ResetDefaultColorButton" Content="Reset to warm white" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Color Palette & Kelvin Layout -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Custom Colour & Sliders -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,12,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Custom Colour Channels" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <!-- Active Colour Preview Disc -->
                        <Grid HorizontalAlignment="Center" Margin="0,8">
                            <Ellipse x:Name="ActiveColorDisc" Width="80" Height="80" Fill="#FF3B30" Stroke="{ThemeResource CardStrokeColorDefaultBrush}" StrokeThickness="2" />
                        </Grid>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Red (0-255)" FontSize="12" Opacity="0.7" />
                            <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Value="255" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Green (0-255)" FontSize="12" Opacity="0.7" />
                            <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" Value="59" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Blue (0-255)" FontSize="12" Opacity="0.7" />
                            <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" Value="48" />
                        </StackPanel>

                        <TextBox x:Name="HexCodeBox" Header="Hex Code" Text="#FF3B30" Width="140" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Right Column: Kelvin Temperature & Swatches -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="12,0,0,0">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Colour Temperature (Kelvin)" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Adjust between warm candlelight (2,700 K) and daylight (6,500 K)" FontSize="12" Opacity="0.6" />

                        <Slider x:Name="KelvinSlider" Minimum="2700" Maximum="6500" Value="4000" StepFrequency="50" Margin="0,8" />
                        <TextBlock x:Name="KelvinReadout" Text="4,000 K (Neutral White)" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="4,000 K (Neutral White)" />

                        <TextBlock Text="Architectural Swatches" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SwatchAmber" Content="Amber" Tag="#FFA500" />
                                <Button x:Name="SwatchWarm" Content="Warm White" Tag="#FFE4B5" />
                                <Button x:Name="SwatchRed" Content="Crimson" Tag="#FF0000" />
                                <Button x:Name="SwatchGreen" Content="Emerald" Tag="#00FF00" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SwatchBlue" Content="Cobalt" Tag="#0000FF" />
                                <Button x:Name="SwatchCyan" Content="Cyan" Tag="#00FFFF" />
                                <Button x:Name="SwatchMagenta" Content="Magenta" Tag="#FF00FF" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
