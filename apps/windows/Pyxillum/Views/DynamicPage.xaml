<Page
    x:Class="Pyxillum.Views.DynamicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- Header Section -->
            <StackPanel Spacing="4">
                <TextBlock Text="Dynamic Effects" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Dynamic Effects" />
                <TextBlock Text="Select from 146 on-chip addressable SPI animation patterns" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Select from 146 on-chip addressable SPI animation patterns" />
            </StackPanel>

            <!-- Error State InfoBar -->
            <InfoBar x:Name="DynamicErrorBar" IsOpen="False" Severity="Error" Title="Effect Dispatch Error" Message="Failed to transfer animation pattern to controller.">
                <InfoBar.ActionButton>
                    <Button x:Name="DynamicRetryButton" Content="Retry" AutomationProperties.Name="Retry syncing dynamic effect" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Loading State Card -->
            <Border x:Name="DynamicLoadingCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="24" Height="24" />
                    <TextBlock Text="Syncing dynamic pattern with controller..." VerticalAlignment="Center" FontWeight="Medium" />
                </StackPanel>
            </Border>

            <!-- Dynamics Controls Bar -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
                        <TextBlock Text="Animation Velocity (Speed)" FontWeight="Medium" FontSize="13" />
                        <Slider x:Name="DynamicSpeedSlider" Minimum="1" Maximum="32" Value="16" AutomationProperties.Name="Animation playback speed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" Margin="16,0">
                        <TextBlock Text="Pattern Luminescence (Brightness)" FontWeight="Medium" FontSize="13" />
                        <Slider x:Name="DynamicBrightnessSlider" Minimum="0" Maximum="255" Value="200" AutomationProperties.Name="Dynamic effect brightness" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="Auto Cycle Loop" FontWeight="Medium" FontSize="13" />
                        <ToggleSwitch x:Name="AutoCycleToggle" OffContent="Off" OnContent="Active" AutomationProperties.Name="Auto cycle loop" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search and Filter Bar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EffectSearchBox" PlaceholderText="Search 146 effects by name or code..." Width="320" HorizontalAlignment="Left" AutomationProperties.Name="Filter effects catalogue">
                    <TextBox.Header>
                        <TextBlock Text="Filter Catalogue" FontWeight="Medium" FontSize="13" Margin="0,0,0,4" />
                    </TextBox.Header>
                </TextBox>
            </Grid>

            <!-- Effects Preset Tile Grid (146 Effects Sample Grid) -->
            <TextBlock Text="Effect Catalogue" Style="{ThemeResource SubtitleTextBlockStyle}" />

            <!-- Empty Search Filter State -->
            <Border x:Name="DynamicEmptyCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="32" Visibility="Collapsed">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE721;" FontSize="40" HorizontalAlignment="Center" Opacity="0.4" />
                    <TextBlock Text="No Matching Effects Found" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Try clearing your search query or entering a different effect name or opcode." Opacity="0.7" TextAlignment="Center" />
                    <Button x:Name="ClearFilterButton" Content="Clear filter" AutomationProperties.Name="Clear search filter" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <GridView x:Name="EffectsGridView" SelectionMode="Single">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Width="200" Height="80">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding Category}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Category}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
