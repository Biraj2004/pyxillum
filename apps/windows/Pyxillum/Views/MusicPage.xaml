<Page
    x:Class="Pyxillum.Views.MusicPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- Header Section -->
            <StackPanel Spacing="4">
                <TextBlock Text="Music Rhythm" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Music Rhythm" />
                <TextBlock Text="Acoustic tracking and real-time spectrum visualizer" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Acoustic tracking and real-time spectrum visualizer" />
            </StackPanel>

            <!-- Error State InfoBar -->
            <InfoBar x:Name="MusicErrorBar" IsOpen="False" Severity="Error" Title="Audio Capture Error" Message="Unable to capture audio from selected source. Check microphone or loopback permissions.">
                <InfoBar.ActionButton>
                    <Button x:Name="MusicRetryButton" Content="Retry" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Loading State Card -->
            <Border x:Name="MusicLoadingCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="24" Height="24" />
                    <TextBlock Text="Initializing audio capture pipeline and frequency bins..." VerticalAlignment="Center" FontWeight="Medium" />
                </StackPanel>
            </Border>

            <!-- Empty State Card -->
            <Border x:Name="MusicEmptyCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="32" Visibility="Collapsed">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xEC4F;" FontSize="40" HorizontalAlignment="Center" Opacity="0.4" />
                    <TextBlock Text="No Sound Detected" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Play music or audio through your PC or speak near the microphone to observe real-time spectrum tracking." Opacity="0.7" TextAlignment="Center" />
                    <Button x:Name="SimulateAudioButton" Content="Simulate 128 BPM beat" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Audio Input Controls -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,16,0">
                        <TextBlock Text="Audio Capture Pipeline" FontWeight="Medium" FontSize="13" />
                        <ComboBox x:Name="AudioSourceCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="PC System Audio (WASAPI Loopback)" />
                            <ComboBoxItem Content="Controller Hardware Internal Mic" />
                            <ComboBoxItem Content="Host Auxiliary Microphone" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8" Margin="16,0,0,0">
                        <TextBlock Text="Acoustic Sensor Sensitivity" FontWeight="Medium" FontSize="13" />
                        <Slider x:Name="SensitivitySlider" Minimum="1" Maximum="100" Value="60" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Real-time 24-band Spectrum Visualizer Canvas -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="24-Band ISO Third-Octave Spectrum" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Canvas x:Name="SpectrumCanvas" Height="100" HorizontalAlignment="Stretch" Background="#111827" />
                </StackPanel>
            </Border>

            <!-- 18 Sound Tracking Algorithms Selector -->
            <TextBlock Text="Sound Reactive Modes (18 Patterns)" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <GridView x:Name="MusicModesGrid" SelectionMode="Single">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Width="200" Height="70">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                                <TextBlock Text="{Binding CodeText}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding CodeText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
