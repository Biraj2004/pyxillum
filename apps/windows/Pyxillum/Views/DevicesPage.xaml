<Page
    x:Class="Pyxillum.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <!-- Header Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Device Hub" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Device Hub" />
                    <TextBlock Text="Discover, connect, and manage nearby SP621E Bluetooth controllers" Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="Discover, connect, and manage nearby SP621E Bluetooth controllers" />
                </StackPanel>
                <Button x:Name="ScanButton" Grid.Column="1" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing x:Name="ScanRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Scan Devices" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Error State InfoBar -->
            <InfoBar x:Name="PageErrorBar" IsOpen="False" Severity="Error" Title="Bluetooth Issue" Message="Unable to access Bluetooth LE adapter.">
                <InfoBar.ActionButton>
                    <Button x:Name="ErrorRetryButton" Content="Retry scan" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Loading State Card -->
            <Border x:Name="LoadingStateCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="32" Visibility="Collapsed">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="48" Height="48" HorizontalAlignment="Center" />
                    <TextBlock x:Name="LoadingStatusText" Text="Scanning for BLE devices..." Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Searching for nearby SP621E pixel LED controllers..." Style="{ThemeResource BodyTextBlockStyle}" Opacity="0.6" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Discovered Controllers Grid / List -->
            <TextBlock x:Name="ListHeader" Text="Discovered Controllers" Style="{ThemeResource SubtitleTextBlockStyle}" />

            <!-- Empty State Card -->
            <Border x:Name="EmptyStateCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="32" Visibility="Visible">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE703;" FontSize="48" HorizontalAlignment="Center" Opacity="0.4" />
                    <TextBlock Text="No SP621E controllers found" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="Make sure the controller is powered and in range, and not connected to companion mobile applications."
                               Style="{ThemeResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" Opacity="0.7" />
                    <Button x:Name="EmptyScanButton" Content="Scan again" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Device Items Repeater / ListView -->
            <ListView x:Name="DeviceListView" SelectionMode="None" Visibility="Collapsed">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE702;" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Address}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Address}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="Connect" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
