<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pyxillum</RootNamespace>
    <AssemblyName>pyxillum-desktop</AssemblyName>
    <ApplicationIcon>..\..\..\assets\pyxillum.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <EnableMsixTooling>false</EnableMsixTooling>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <Version>1.0.5</Version>
    <Authors>Pyxillum Contributors</Authors>
    <Company>Pyxillum</Company>
    <Product>Pyxillum Native Desktop</Product>
    <Description>Native Windows 11 WinUI 3 Bluetooth Low Energy LED Controller</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.174" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="System.Security.Permissions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pyxillum.Core\Pyxillum.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\target\release\pyxillum_ffi.dll" Condition="Exists('..\..\..\target\release\pyxillum_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\..\target\x86_64-pc-windows-msvc\release\pyxillum_ffi.dll" Condition="Exists('..\..\..\target\x86_64-pc-windows-msvc\release\pyxillum_ffi.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
